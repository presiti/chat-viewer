{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat Viewer",
  "version": "0.2.2",
  "identifier": "co.duo.chat-viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chat Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Synology Chat 경량 클라이언트",
    "longDescription": "Synology Chat 서버에 바로 접속하는 가벼운 데스크톱 클라이언트",
    "copyright": "© 2026 duo",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Chat Viewer",
        "installerHooks": "./windows/hooks.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/presiti/chat-viewer-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERUYxNzJBNTY4N0REQ0IKUldUTDNZZFdLaGZ2Ylp5TU1sMGZDM3pGR2lzK1VmbEZ5WWk2Y3RRWUUyZWRpeWJIaXlBaTVQbWYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
